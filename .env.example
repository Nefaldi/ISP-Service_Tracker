# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# Web Service Tracker & Helpdesk Ticket Management System
# ==============================================================================

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/web_service_tracker?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/web_service_tracker?schema=public"

# NextAuth / Auth.js Configuration
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="super-secret-auth-key-change-this-in-production-min-32-chars"
NEXTAUTH_SECRET="super-secret-auth-key-change-this-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# AWS S3 / Cloudflare R2 Object Storage Configuration
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_S3_BUCKET_NAME="web-service-tracker-uploads"
# Optional custom endpoint (e.g. for Cloudflare R2 or MinIO local dev)
# AWS_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
